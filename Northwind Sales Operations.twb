      <aliases enabled='yes' />
      <column caption='Line Total' datatype='real' name='[Calculation_0638590317490176]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[unitPrice] * [quantity] * (1 - [discount])' />
      </column>
      <column caption='Shipping Delay (Days)' datatype='integer' name='[Calculation_0638590317670401]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [requiredDate], [shippedDate])' />
      </column>
      <column caption='On-Time Delivery' datatype='string' name='[Calculation_0638590317785090]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [shippedDate] &lt;= [requiredDate] THEN &quot;On Time&quot; ELSE &quot;Late&quot; END' />
      </column>
      <column caption='Avg Order Value' datatype='real' name='[Calculation_0638590318587907]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_0638590317490176])/COUNTD([orderID])' />
      </column>
      <column caption='On Time Flag' datatype='integer' name='[Calculation_0638590321893381]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [shippedDate] &lt;= [requiredDate] THEN 1 ELSE 0 END' />
      </column>
      <column caption='Delivery Status' datatype='string' name='[Calculation_0638590328160262]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [shippedDate] &lt;= [requiredDate] THEN &quot;On Time&quot; ELSE &quot;Late&quot; END' />
      </column>
      <column caption='Shipping Delay' datatype='integer' name='[Calculation_0638590332825607]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [orderDate], [shippedDate])' />
